# NeuroPulse Backend Environment
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# DeepSeek AI Configuration (Neuro-Consultant)
# Leave DEEPSEEK_API_KEY empty to run in demo mode (consultant returns 500).
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://gateway.9arm.co/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# Database Configuration
DATABASE_PATH=./data/brainprint.db

# CORS Configuration — comma-separated origins the browser may call from.
# Add your Vercel URL (e.g. https://xxx.vercel.app) once the frontend is deployed.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Brainprint Security Thresholds
BRAINPRINT_SIMILARITY_THRESHOLD=0.82
BRAINPRINT_MAHALANOBIS_THRESHOLD=3.0

# JWT Authentication Configuration
# (ALGORITHM is hardcoded to HS256 in main.py — no env override.)
SECRET_KEY=change-me-to-a-strong-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Demo / WebSocket stream
# Set to "true" to DISABLE the /ws/eeg-stream live demo stream.
# Default (false/empty) keeps it enabled for the Live Monitor.
DISABLE_DEMO_STREAM=false

# Optional: absolute base URL used only when building share-report links.
# Defaults to http://127.0.0.1:8765 when unset.
# NEXT_PUBLIC_API_URL=https://your-backend-host