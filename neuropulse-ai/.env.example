# NeuroPulse AI Frontend Environment
# Copy this file to .env.local and adjust values as needed.

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL — Backend HTTP base URL
#
#   NOT REQUIRED for local development — the app auto-detects localhost and
#   defaults to http://127.0.0.1:8765.
#
#   REQUIRED when accessing the app via a Cloudflare tunnel, ngrok, or any
#   non-localhost hostname.  Set this to the backend's tunnel URL, e.g.:
#     NEXT_PUBLIC_API_URL=https://your-tunnel-domain.trycloudflare.com
#
#   IMPORTANT: NEXT_PUBLIC_* variables are baked into the bundle at build
#   time.  After changing this value you MUST restart the Next.js dev server
#   (Ctrl+C then `npm run dev`) for it to take effect.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8765

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_WS_URL — WebSocket URL (optional override)
#
#   NOT REQUIRED — the app derives the WebSocket URL from NEXT_PUBLIC_API_URL
#   (http → ws, https → wss) automatically.  Only set this if you need a
#   custom WebSocket endpoint that differs from the API base.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8765/ws/eeg-stream
